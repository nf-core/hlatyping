/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running combined OptiType + SpecHLA tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises shared Yara mapping and the RNA seq_type -> -u 1 branch.

    Use as follows:
        nextflow run nf-core/hlatyping -profile test_optitype_spechla,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'OptiType + SpecHLA (DNA/RNA) Test Profile'
    config_profile_description = 'PE FASTQ DNA + RNA samples typed with OptiType and SpecHLA'

    input = params.pipelines_testdata_base_path + 'hlatyping/samplesheets/samplesheet_dna_rna.csv'
    tools = 'optitype,spechla'
    solver = 'glpk'
}
