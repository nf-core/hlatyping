/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/hlatyping -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    // Raised from the light-test defaults so the full-genome STAR index build (RNA -> SpecHLA) fits;
    // bwa uses the pre-built iGenomes hg38 index, so no bwa-index build.
    resourceLimits = [
        cpus: 16,
        memory: '60.GB',
        time: '16.h'
    ]
}

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size test exercising OptiType, SpecHLA, HLA*LA (via GRCh38 alignment) and immunotype'

    // Input data for full size test
    input = params.pipelines_testdata_base_path + 'hlatyping/samplesheets/samplesheet_full.csv'

    // All public tools (HLA-HD is licensed -> covered by the dedicated hlahd nf-test job, not here)
    tools  = 'optitype,spechla,hlala,immunotype'
    // UCSC hg38: chr-named (chr6, chrUn_*, *_alt) so HLA*LA's knownReferences match; iGenomes ships a pre-built bwa index
    genome = 'hg38'

    // pipeline parameters
    solver = 'glpk'

}
