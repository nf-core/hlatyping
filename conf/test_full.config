/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/hlatyping -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size test exercising SpecHLA and HLA*LA (via GRCh38 alignment) and immunotype'

    // Input data for full size test
    input = params.pipelines_testdata_base_path + 'hlatyping/samplesheets/samplesheet_full.csv'

    // The full-size data exists to exercise the FASTQ -> GRCh38 -> BAM path that SpecHLA and HLA*LA need.
    // OptiType is left out: it types HLA-fished reads, so full depth buys no coverage the light DNA/RNA
    // profiles do not already give, and its ILP on the 93.6M-pair RNA sample peaks at 68 GB over 4h on a
    // single core. HLA-HD is licensed and covered by the dedicated hlahd nf-test job.
    tools  = 'spechla,hlala,immunotype'
    // UCSC hg38: chr-named (chr6, chrUn_*, *_random) so HLA*LA's knownReferences match; iGenomes ships a pre-built bwa index
    genome = 'hg38'

    // pipeline parameters
    solver = 'glpk'

}
