/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for resolving the reference from --genome instead of --fasta
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [ cpus: 4, memory: '15.GB', time: '2.h' ]
}

params {
    config_profile_name        = 'FASTQ->BAM --genome test'
    config_profile_description = 'Resolve the reference fasta from the igenomes hg38 entry (bwa-mem2 index built on the fly)'

    input  = params.pipelines_testdata_base_path + 'hlatyping/samplesheets/samplesheet_fastq.csv'
    tools  = 'spechla'
    genome = 'hg38'
    // Fixture tree mirroring the igenomes layout, so the hg38 entry resolves without touching S3
    igenomes_base = "${projectDir}/tests/fixtures/igenomes"
}
