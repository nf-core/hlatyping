/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config: HLA*LA must fail fast on a GENCODE/Ensembl-named reference
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [ cpus: 4, memory: '15.GB', time: '2.h' ]
}

params {
    config_profile_name        = 'HLA*LA incompatible-reference guard'
    config_profile_description = 'FASTQ + HLA*LA with a GENCODE-named reference must fail fast'

    input     = params.pipelines_testdata_base_path + 'hlatyping/samplesheets/samplesheet_fastq.csv'
    tools     = 'hlala'
    fasta     = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta'
    fasta_fai = params.pipelines_testdata_base_path + 'hlatyping/reference/genome_gencode.fa.fai'
}
