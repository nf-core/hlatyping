/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running ImmunoType tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines bundled input files and everything required to run a fast and simple test.

    Use as follows:
        nextflow run nf-core/hlatyping -profile test_immunotype,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
 */

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'ImmunoType Test Profile'
    config_profile_description = 'Test dataset with MHCquant-style peptide TSV using ImmunoType'

    // TODO: migrate to nf-core/test-datasets once fixtures are uploaded.
    // The samplesheet is generated at runtime by tests/immunotype.nf.test so the
    // peptide_tsv path resolves correctly; for direct CLI use, provide --input.
    tools = 'immunotype'
}
