/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for a mixed samplesheet (reads + peptides) typed by tool-appropriate tools
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [ cpus: 4, memory: '15.GB', time: '2.h' ]
}

params {
    config_profile_name        = 'Mixed reads + peptide test'
    config_profile_description = 'A read-based tool and a peptide-based tool over one samplesheet holding both input types'

    // Local fixture: the public samplesheets each hold a single input type
    input  = "${projectDir}/tests/fixtures/samplesheet_mixed.csv"
    tools  = 'spechla,immunotype'
    fasta  = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta'
}
