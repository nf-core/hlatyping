// Test-local config for the isolated FASTQ_ALIGN run; the real pipeline sets these in conf/modules.config.
process {
    // zcat for gzipped FASTQ; --genomeSAindexNbases 9 suits the tiny chr22 test genome.
    withName: STAR_GENOMEGENERATE {
        ext.args = '--genomeSAindexNbases 9'
    }
    withName: STAR_ALIGN {
        ext.args = '--readFilesCommand zcat'
    }

    // distinct sort prefix so SAMTOOLS_SORT output can't collide with its input BAM name.
    withName: '.*:BAM_SORT_STATS_SAMTOOLS.*:SAMTOOLS_.*' {
        ext.prefix = { "${meta.id}.sorted" }
    }
    withName: '.*:BAM_SORT_STATS_SAMTOOLS.*:BAM_STATS_SAMTOOLS:.*' {
        ext.prefix = { "${meta.id}.sorted.bam" }
    }
}
