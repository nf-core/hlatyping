// Test-local config for the isolated FASTQ_ALIGN subworkflow run.
// The real pipeline sets these in conf/modules.config (Task 7).
process {
    // STAR needs --readFilesCommand zcat to read gzipped FASTQ (unlike bwa it does
    // not auto-detect gzip). --genomeSAindexNbases 9 suits the tiny chr22 test genome.
    withName: STAR_GENOMEGENERATE {
        ext.args = '--genomeSAindexNbases 9'
    }
    withName: STAR_ALIGN {
        ext.args = '--readFilesCommand zcat'
    }

    // BAM_SORT_STATS_SAMTOOLS sorts the aligner output; without a distinct prefix the
    // SAMTOOLS_SORT output name collides with its input BAM name and errors out.
    withName: '.*:BAM_SORT_STATS_SAMTOOLS.*:SAMTOOLS_.*' {
        ext.prefix = { "${meta.id}.sorted" }
    }
    withName: '.*:BAM_SORT_STATS_SAMTOOLS.*:BAM_STATS_SAMTOOLS:.*' {
        ext.prefix = { "${meta.id}.sorted.bam" }
    }
}
