nextflow_pipeline {

    name "Test pipeline with ImmunoType"
    script "../main.nf"
    tag "pipeline"
    tag "immunotype"
    profile "test_immunotype"

    // TODO: once the MHCquant-style peptide TSV test fixture has been uploaded to
    // nf-core/test-datasets under the 'hlatyping' branch, drop the setup block and
    // point `input` in conf/test_immunotype.config to the remote samplesheet.
    test("-profile test_immunotype (stub)") {

        options "-stub-run"

        setup {
            def fixtures = new File("$outputDir/fixtures")
            fixtures.mkdirs()
            new File(fixtures, "HepG2_A.tsv").text = "sequence\tprotein_accessions\nPEPTIDEAAA\tP0001\nPEPTIDEBBB\tP0002\n"
            def samplesheet = new File("$outputDir/samplesheet.csv")
            samplesheet.text = """\
sample,fastq_1,fastq_2,bam,tsv,seq_type
HepG2_A,,,,${fixtures}/HepG2_A.tsv,peptide
"""
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$outputDir/samplesheet.csv"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_hlatyping_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }
}
