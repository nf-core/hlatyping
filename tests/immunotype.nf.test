nextflow_pipeline {

    name "Test pipeline with ImmunoType"
    script "../main.nf"
    tag "pipeline"
    tag "immunotype"
    profile "test_immunotype"

    test("-profile test_immunotype (stub)") {

        options "-stub-run"

        setup {
            def samplesheet = new File("$outputDir/samplesheet.csv")
            samplesheet.parentFile.mkdirs()
            samplesheet.text = """\
sample,fastq_1,fastq_2,bam,peptide_tsv,seq_type
HepG2_A,,,,${projectDir}/tests/fixtures/immunotype/HepG2_A.tsv,peptide
"""
        }

        when {
            params {
                outdir = "$outputDir"
                input  = "$outputDir/samplesheet.csv"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.trace.succeeded().size(),
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_hlatyping_software_mqc_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }
}
